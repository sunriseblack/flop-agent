+    let current = initial;
+    for (let depth = 0; current && typeof current === 'object'; depth++) {
+      if (depth === 4 || seen.has(current)) { truncated = true; break; }
+      seen.add(current);
+      let kind;
+      let reportedOutcome;
+      switch (data(current, 'code')) {
