+    try:
+        line = json.dumps(obj, allow_nan=False, **kw)
+    except ValueError:
+        unknown = {"error": "non_finite_json", "state": None}
+        # These fields are set by main(), not copied from the receipt packet.
+        for field in ("http", "flag"):
+            if field in obj:
+                unknown[field] = obj[field]
+        line = json.dumps(unknown, allow_nan=False, **kw)
